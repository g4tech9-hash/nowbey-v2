+ */
+export function insecureServer(url: string): boolean {
+  let u: URL;
+  try {
+    u = new URL(url);
+  } catch {
+    return true;
+  }
+  if (u.protocol === "https:") return false;
+  if (u.protocol !== "http:") return true;
+  const h = u.hostname;
