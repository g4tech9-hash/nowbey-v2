+    console.log(`  deliberate 503 "not set up" replies (not findings):`);
+    for (const u of new Set([...unavailable].map((x) => x.replace(/ → 503.*/, "")))) console.log(`    ${u}`);
+  }
+  if (cookie) {
+    const me = await fetch(`${BASE}/api/session`, { headers: { cookie } }).then((r) => r.json()).catch(() => ({}));
