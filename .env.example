# fixtures (default) replays the captured corpus in wire/fixtures — no network.
# live fetches the real Bahamian sources on each revalidation.
WIRE_MODE=fixtures

# Revalidate the wire payload every N seconds.
WIRE_REVALIDATE_SECONDS=600

# Alerts (missing-person / public safety) — fixtures by default; set live to
# poll the real Bahamian sources on each revalidation.
ALERTS_MODE=fixtures
ALERTS_REVALIDATE_SECONDS=600

# Protects /api/wire/refresh and /api/alerts/refresh when called by a cron.
CRON_SECRET=
