# fixtures (default) replays the captured corpus in wire/fixtures — no network.
# live fetches the real Bahamian sources on each revalidation.
WIRE_MODE=fixtures

# Revalidate the wire payload every N seconds.
WIRE_REVALIDATE_SECONDS=600

# Protects /api/wire/refresh when it is called by a Vercel cron.
CRON_SECRET=
