# Copy these into .env and fill in what you use. Everything is optional: without a key the
# matching feature simply stays in its "not set up" state (see the Admin page checklist).

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Public address of the site. Used in links inside emails and in checkout return links.
APP_URL=https://your-site.example

# Random text used to sign sign-in sessions. Change it for any real deployment.
AUTH_SECRET=

# Payments (Stripe). Create the webhook endpoint  <APP_URL>/api/billing/webhook
# and send it: checkout.session.completed, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Resend, https://resend.com). MAIL_FROM must be an address on a domain you verified there.
RESEND_API_KEY=
MAIL_FROM=NowBey <alerts@your-site.example>
# Where Enterprise enquiries are emailed.
ENTERPRISE_NOTIFY_TO=

# Comma-separated handles that can open /admin. Register the account first, then add the handle.
ADMIN_HANDLES=

# Look and feel. Leave both unset to use whatever an admin chose on the Admin > Appearance page.
# NOWBEY_THEME=classic forces the original plain look (no photos, no splash), whatever the admin page says.
# NOWBEY_SPLASH=off hides only the opening splash screen.
NOWBEY_THEME=
NOWBEY_SPLASH=

# Shown on the Terms and Privacy pages: where people can reach you about content and privacy.
SUPPORT_EMAIL=

# Email (pick ONE). Gmail example: turn on 2-step verification, make an "App password", then:
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# MAIL_FROM="NowBey <you@gmail.com>"
# RESEND_API_KEY=
# Government-set gas prices to show on the Gas page, B$ per gallon:
# GAS_OFFICIAL="regular=5.12,premium=5.60,diesel=4.95"
# News: extra feeds, e.g. Facebook pages through an RSS service such as rss.app
# NEWS_FEEDS="242 In The Know|https://rss.app/feeds/xxxx.xml,The Bahamas Times|https://rss.app/feeds/yyyy.xml"
