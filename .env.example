# Copy these into .env and fill in what you use. Everything is optional: without a key the
# matching feature simply stays in its "not set up" state (see the Admin page checklist).

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Public address of the site. Used in links inside emails and in checkout return links.
APP_URL=https://your-site.example

# Random text used to sign sign-in sessions. Change it for any real deployment.
AUTH_SECRET=

# Secret both Vercel cron and the cron routes share. Required: cron routes 404 without it.
CRON_SECRET=

# Payments (Stripe). Create the webhook endpoint  <APP_URL>/api/billing/webhook
# and send it: checkout.session.completed, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Resend, https://resend.com). MAIL_FROM must be an address on a domain you verified there.
RESEND_API_KEY=
MAIL_FROM=NowBey <alerts@your-site.example>
# Where Enterprise enquiries are emailed.
ENTERPRISE_NOTIFY_TO=

# Comma-separated handles that can open /admin. Register the account first, then add the handle.
ADMIN_HANDLES=

# Look and feel. Leave both unset to use whatever an admin chose on the Admin > Appearance page.
# NOWBEY_THEME=classic forces the original plain look (no photos, no splash), whatever the admin page says.
# NOWBEY_MODE=light forces the light brightness, whatever the admin page says.
# NOWBEY_SPLASH=off hides only the opening splash screen.
NOWBEY_THEME=
NOWBEY_MODE=
NOWBEY_SPLASH=

# Shown on the Terms and Privacy pages: where people can reach you about content and privacy.
SUPPORT_EMAIL=

# Email (pick ONE). Gmail example: turn on 2-step verification, make an "App password", then:
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# MAIL_FROM="NowBey <you@gmail.com>"
# RESEND_API_KEY=
# Government-set gas prices to show on the Gas page, B$ per gallon:
# GAS_OFFICIAL="regular=5.12,premium=5.60,diesel=4.95"
# News: extra feeds, e.g. Facebook pages through an RSS service such as rss.app
# NEWS_FEEDS="242 In The Know|https://rss.app/feeds/xxxx.xml,The Bahamas Times|https://rss.app/feeds/yyyy.xml"

# AI (Google Gemini, https://aistudio.google.com — free tier is plenty for Nassau scale).
# With a key set: wire stories get a two-sentence plain-English brief (shown as "AI brief"),
# stories missing a place get one more chance to be pinned on the map, the Community
# Digest drafts itself for review, and new reports/comments/posts/photos get a first-pass
# moderation screen (it can only raise a staff flag — it never hides anything itself).
# Unset = everything silently keeps its old behaviour.
GEMINI_API_KEY=
# Optional. Any Gemini generateContent model id works.
# GEMINI_MODEL=gemini-2.0-flash

# Official bulletins (no key needed): the US National Hurricane Center's Atlantic feeds are
# always imported — watches/warnings that concern The Bahamas become "official" pins on the map
# and fire email + push alerts to subscribers. Newer advisories resolve the previous pin.
# Add other agencies' RSS (e.g. via rss.app) with the same NAME|URL convention as NEWS_FEEDS:
# OFFICIAL_EXTRA_FEEDS="Bahamas Department of Meteorology|https://rss.app/feeds/xxxx.xml"
# Cron: schedule /api/cron/official-feeds every 15–60 min (the map also self-refreshes off traffic).

# Google Cloud (console.cloud.google.com). Geocoding API key, restricted to the Geocoding API.
# Optional middle rung of the geocoder chain: OpenStreetMap → Google → local gazetteer.
# Only called when the free geocoder finds nothing, it stays inside Google's $200/month credit,
# and address searches/pin drops get Nassau streets OSM does not know. Unset = no change.
GOOGLE_MAPS_API_KEY=

# Push alerts (Firebase Cloud Messaging, https://console.firebase.google.com — free, unlimited).
# Server side: Project settings > Service accounts > Generate new private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# The key's private_key field on ONE line, with every newline written as \n
FIREBASE_PRIVATE_KEY=
# Browser side: Project settings > Your apps > Web app config, plus the Web Push certificates
# key pair (vapid) from Project settings > Cloud Messaging.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
