# fixtures (local default) replays the captured corpus in wire/fixtures — no network.
# live fetches the real Bahamian sources on each revalidation (enabled automatically on Vercel).
WIRE_MODE=fixtures

# Revalidate the wire payload every N seconds.
WIRE_REVALIDATE_SECONDS=600

# Marco's Alert & missing-person alerts engine:
# Official Cell Broadcast bulletins in wire/bulletins.json + POST /api/alerts are ALWAYS active.
# Set ALERTS_MODE=live locally (automatic on Vercel) to also poll Bahamian RSS feeds + Google News.
ALERTS_MODE=fixtures
ALERTS_REVALIDATE_SECONDS=120

# Facebook → strict RSS 2.0 generator (/api/rss/facebook, wire/lib/facebook.mjs):
# Reads site_settings.fb_pages & site_settings.fb_bridges from DATABASE_URL when configured,
# plus these optional env fallbacks ("handle|Display Name,..." and "handle|https://.../rss.xml,..."):
FB_PAGES=
FB_RSS_BRIDGES=
# Convenience shorthand bridge URL specifically for Royal Bahamas Police Force (@rbpfpublicaffairs):
RBPF_FB_RSS_URL=

# Optional comma-separated extra alert feeds ("Source Name|https://.../rss.xml"):
ALERTS_EXTRA_FEEDS=

# Optional secret to authorize POST /api/alerts (verified flag) and POST /api/rss/facebook:
ALERTS_INGEST_SECRET=

# Protects /api/wire/refresh and /api/alerts/refresh when called by a cron.
CRON_SECRET=
