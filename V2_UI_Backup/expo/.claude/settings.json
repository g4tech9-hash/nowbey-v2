{
  "permissions": {
    "deny": [
      "Read(**/node_modules/**)",
      "Read(**/package-lock.json)",
      "Read(**/.expo/**)",
      "Read(**/dist/**)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/preflight.js", "timeout": 600 }
        ]
      }
    ]
  }
}
