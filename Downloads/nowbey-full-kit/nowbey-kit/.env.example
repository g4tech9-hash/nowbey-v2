# Copy this into .env  (never commit it — .gitignore covers .env*)
# Where each value comes from, click by click: CREDENTIALS.md
# Check them all with:  node scripts/preflight.mjs

# ── Instagram + Facebook ────────────────────────────────────────────────────
# Long-lived token (60 days) or a System User token (does not expire).
# Scopes: instagram_basic, instagram_content_publish, pages_show_list, pages_manage_posts
# Replace everything after the "=" with the token (EAA…, ~200 chars, one line,
# no quotes). Re-generating a token means replacing this value — do not add a
# second META_TOKEN= line.
META_TOKEN=

# Instagram Business account id, e.g. 17841400000000000   (--write fills this in too)
IG_USER_ID=

# Facebook Page id, e.g. 100000000000000   (node scripts/preflight.mjs --write fills this in)
FB_PAGE_ID=

# Graph API version
GRAPH_VERSION=v21.0

# Optional — only needed to extend a token from the command line.
# Business settings → Apps → NowBey → Settings → Basic → App secret → Show.
# Never commit these; .gitignore covers .env*.
APP_ID=
APP_SECRET=

# ── TikTok ──────────────────────────────────────────────────────────────────
# User access token from the TikTok developer app, scopes video.publish (+ video.upload).
# Direct Post requires the app to have passed TikTok's Content Posting audit; until then
# the API only accepts private accounts. See START_HERE.md step 6 for the manual path.
TT_TOKEN=

# ── Where the kit is hosted (public, no login) ──────────────────────────────
# e.g. https://nowbey.com/kit  or a Netlify Drop url
KIT_BASE=
