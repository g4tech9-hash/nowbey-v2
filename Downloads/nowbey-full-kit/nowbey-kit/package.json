{
  "name": "nowbey-marketing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Generates the NowBey social launch kit (feed posts, stories, reels, thumbnails) from the product's own design tokens.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:posts": "node scripts/build.mjs posts",
    "build:batch2": "node scripts/build-batch2.mjs",
    "build:stories": "node scripts/build.mjs stories",
    "build:video": "node scripts/build-video.mjs",
    "sheet": "node scripts/contact-sheet.mjs",
    "fonts": "python3 scripts/make-static-fonts.py",
    "check:tokens": "node scripts/check-tokens.mjs",
    "gallery": "node scripts/serve.mjs",
    "publish": "node scripts/publish.mjs",
    "index": "node scripts/kit-index.mjs",
    "pages": "node scripts/find-pages.mjs",
    "build:brand": "node scripts/build-brand.mjs",
    "build:identity": "node scripts/build-brand-identity.mjs",
    "token": "node scripts/token-extend.mjs",
    "zips": "python3 scripts/build-downloads.py"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "@resvg/resvg-js": "^2.6.2",
    "fontkit": "^2.0.4",
    "qrcode-generator": "^1.4.4"
  }
}
