    "next": "^16.4.0",
    "openplaces": "^0.3.5",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-leaflet": "^5.0.0",
    "sharp": "^0.35.5",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/dompurify": "^3.0.5",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
