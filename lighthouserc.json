{
  "ci": {
    "collect": {
      "url": ["http://localhost:3000/", "http://localhost:3000/map", "http://localhost:3000/report"],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.6 }],
        "resource-summary:script:size": ["warn", { "maxNumericValue": 1200000 }],
        "resource-summary:third-party:count": ["warn", { "maxNumericValue": 25 }]
      }
    }
  }
}
