{
  "expo": {
    "name": "NowBey",
    "slug": "nowbey",
    "version": "1.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.nowbey.mobile",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "NowBey uses your location to drop a report pin on the right spot.",
        "NSCameraUsageDescription": "NowBey needs camera access to attach photos to a report.",
        "NSPhotoLibraryUsageDescription": "NowBey needs photo library access to attach photos to a report."
      }
    },
    "android": {
      "package": "app.nowbey.mobile",
      "googleServicesFile": "./google-services.json",
      "versionCode": 4,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#03121b"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2ee6d0"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NowBey uses your location to drop a report pin on the right spot.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "scheme": "nowbey",
    "backgroundColor": "#03121b",
    "extra": {
      "apiBase": "https://nowbey-v2.vercel.app",
      "router": {},
      "eas": {
        "projectId": "7c347b21-e481-4485-9512-4bdd64eb19a5"
      }
    },
    "icon": "./assets/icon.png",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "nowbey-v3s-team",
    "updates": {
      "url": "https://u.expo.dev/7c347b21-e481-4485-9512-4bdd64eb19a5"
    }
  }
}
