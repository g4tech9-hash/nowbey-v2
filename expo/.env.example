# Where NowBey's website runs. The app uses the same API as the site.
# On a real phone, "localhost" is the phone itself, so use your live address
# or your computer's network address, for example http://192.168.1.20:3000
EXPO_PUBLIC_API_BASE=https://your-nowbey-site.example

# Deferred for the Nassau hazard/news MVP. Both expanded stage and a feature flag are required.
EXPO_PUBLIC_LAUNCH_STAGE=nassau
EXPO_PUBLIC_FEATURE_ISLAND_LIFE=false
EXPO_PUBLIC_FEATURE_GAS_TRACKER=false

# Not an app environment variable, on purpose: EXPO_TOKEN is a credential for CI only. It lives in
# the repository secret of the same name (Settings > Secrets and variables > Actions) and is created
# on expo.dev > Account settings > Access tokens while logged in as the account that owns the
# project. Never put it here, never commit it. `cd expo && npm run eas:check` shows which account the
# committed app.json points at; docs/EAS_ACCOUNT_RELINK.md is the move procedure.
